{
  "id": "./",
  "name": "ระบบบริการการแพทย์แผนไทยและการแพทย์ทางเลือก CUP สันทราย",
  "short_name": "OPD แผนไทย",
  "description": "OPD Card แพทย์แผนไทย สำหรับ รพ.สต.",
  "lang": "th",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f9dcf9",
  "theme_color": "#9B7EDE",
  "categories": [
    "medical",
    "health",
    "productivity"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "บันทึก OPD Card ใหม่",
      "short_name": "OPD ใหม่",
      "url": "./?page=opdForm&source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "นำเข้าอัตโนมัติจากไฟล์",
      "short_name": "นำเข้า",
      "url": "./?page=import&source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "นัดหมาย",
      "short_name": "นัดหมาย",
      "url": "./?page=appointments&source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "ทะเบียนผู้รับบริการ",
      "short_name": "ทะเบียน",
      "url": "./?page=patients&source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "prefer_related_applications": false
}
